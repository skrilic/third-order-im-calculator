{
    "name": "Intermod RF Sites",
    "description": "Transmitter site register and third-order intermodulation calculator",
    "version": "1.2",
    "manifest_version": 3,
    "optional_permissions": [
      "geolocation"
    ],
    "action": {
      "default_popup": "index.html",
